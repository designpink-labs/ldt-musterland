{#
/**
 * @file
 * HTML5-Video mit WebVTT-Untertiteln.
 *
 * Variablen:
 * - video_url: Adresse der Videodatei (inkl. Basis-Pfad, z. B. /drupal/...).
 * - video_mime: MIME-Typ des Videos, z. B. video/mp4.
 * - video_size: Dateigröße, lesbar formatiert.
 * - track_url: Adresse der WebVTT-Datei oder leer.
 * - track_srclang: Sprachcode der Untertitel (Sprache der Seite).
 * - track_label: Bezeichnung der Untertitel im Player.
 *
 * Kein Autoplay: Nutzer*innen starten das Video selbst (WCAG 1.4.2, 2.2.2).
 */
#}
<div class="designpink-video">
  <video controls preload="metadata" playsinline>
    <source src="{{ video_url }}" type="{{ video_mime }}">
    {% if track_url %}
      <track kind="captions" src="{{ track_url }}" srclang="{{ track_srclang }}" label="{{ track_label }}" default>
    {% endif %}
    <p>Ihr Browser kann dieses Video nicht abspielen. <a href="{{ video_url }}">Video herunterladen ({{ video_mime }}, {{ video_size }})</a></p>
  </video>
</div>
