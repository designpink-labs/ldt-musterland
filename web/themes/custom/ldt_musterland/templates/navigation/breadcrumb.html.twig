{#
/**
 * @file
 * Brotkrumen "Sie sind hier". Das letzte Element ist die aktuelle Seite
 * (aria-current="page", kein Link) – siehe LdtMusterlandHooks.
 */
#}
{% if breadcrumb %}
  <nav class="breadcrumb" aria-labelledby="system-breadcrumb">
    <h2 id="system-breadcrumb" class="breadcrumb__label">{{ 'Breadcrumb'|t }}</h2>
    <ol class="breadcrumb__list">
      {% for item in breadcrumb %}
        <li class="breadcrumb__item">
          {% if item.url %}
            <a href="{{ item.url }}">{{ item.text }}</a>
          {% else %}
            <span aria-current="page">{{ item.text }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
{% endif %}
