{#
/**
 * @file
 * Hauptnavigation nach dem Disclosure-Muster.
 *
 * - Oberpunkte bleiben Links zur Übersichtsseite.
 * - Daneben ein Button mit aria-expanded/aria-controls für das Untermenü.
 * - Aktuelle Seite: aria-current="page" (current_path aus LdtMusterlandHooks).
 * - Ohne JavaScript sind die Buttons ausgeblendet (siehe ldt-navigation.css).
 */
#}
{% if items %}
  <ul class="main-nav__list main-nav">
    {% for item in items %}
      {% set is_current = item.url.toString() == current_path %}
      {% set sub_id = 'untermenue-' ~ item.title|clean_id %}
      {%
        set classes = [
          'main-nav__item',
          item.below ? 'main-nav__item--has-children',
          item.in_active_trail ? 'main-nav__item--active-trail',
        ]
      %}
      <li{{ item.attributes.addClass(classes) }}>
        <div class="main-nav__row">
          <a href="{{ item.url }}" class="main-nav__link"{% if is_current %} aria-current="page"{% endif %}>{{ item.title }}</a>
          {% if item.below %}
            <button type="button" class="main-nav__toggle" aria-expanded="false" aria-controls="{{ sub_id }}">
              <span class="visually-hidden">Untermenü {{ item.title }}</span>
              {{ include('@ldt_musterland/icons/icon-chevron.html.twig') }}
            </button>
          {% endif %}
        </div>
        {% if item.below %}
          <ul class="main-nav__submenu" id="{{ sub_id }}">
            {% for sub in item.below %}
              <li class="main-nav__subitem">
                <a href="{{ sub.url }}" class="main-nav__sublink"{% if sub.url.toString() == current_path %} aria-current="page"{% endif %}>{{ sub.title }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endif %}
